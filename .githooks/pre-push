#!/usr/bin/env bash
# Pre-push gate: unit tests (no DB, no server). CI runs the full suite
# against an ephemeral Postgres. Skip with SKIP_TESTS=1 or --no-verify.
set -e
if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "[pre-push] SKIP_TESTS=1 — bypassing tests."
  exit 0
fi
echo "[pre-push] Running npm test…"
npm test
